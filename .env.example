# Wefulfil API configuration. Leave API key empty to use built-in demo orders.
WEFULFIL_BASE_URL=https://api.wefulfil.example
WEFULFIL_API_KEY=

# Tracking provider: mock, 17track, or 51track. WFF first production target is 51track.
TRACKING_PROVIDER=51track
TRACKING_API_KEY=

# Report output and delivery.
REPORT_OUTPUT_DIR=reports
DRY_RUN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=fulfillment-reports@example.com
MAIL_TO=fulfillment-lead@example.com

# DingTalk group robot. Use DINGTALK_AT_MOBILES to mention the precise fulfillment owner in the group.
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
DINGTALK_AT_MOBILES=
